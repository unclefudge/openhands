APP_NAME="Open Hands"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://openhands.test
APP_TIMEZONE=Australia/Hobart

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="website@openhands.com.au"
MAIL_FROM_NAME="${APP_NAME}"

# This address is server-side only and is never displayed in the website.
ENQUIRY_TO_ADDRESS="support@openhands.com.au"
ENQUIRY_TO_NAME="Open Hands"

# Optional extra bot protection. Leave blank while developing locally.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VITE_APP_NAME="${APP_NAME}"
